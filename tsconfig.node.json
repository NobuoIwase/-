{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "composite": true
  },
  "include": [
    "vite.config.ts",
    "scripts/*.ts",
    "src/engine/*.ts",
    "src/types.ts"
  ]
}